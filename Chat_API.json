    },
    {
      "parameters": {
        "jsCode": "const rows = $input.all();\nlet combinedContext = \"\";\n\nrows.forEach((row, index) => {\n    combinedContext += `--- Excerpt ${index + 1} ---\\n${row.json.content}\\n\\n`;\n});\n\nconst query = $('Webhook').first().json.body.query;\n\nreturn {\n    json: {\n        query: query,\n        context: combinedContext\n    }\n};"
      },
