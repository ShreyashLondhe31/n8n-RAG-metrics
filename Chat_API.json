    {
      "parameters": {
        "jsCode": "const embeddingData = $input.first().json.embeddings[0];\nconst query = $('Webhook').item.json.body.query;\n\nreturn {\n    json: {\n        query: query,\n        vector_string: \"[\" + embeddingData.join(\",\") + \"]\"\n    }\n};"
      },
      "id": "b9dc5325-eb65-4a45-a05d-bf318716ac95",
